<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Max Pane</string>
	<key>CFBundleDisplayName</key>
	<string>Max Pane</string>
	<key>CFBundleExecutable</key>
	<string>MaxPane</string>
	<key>CFBundleIdentifier</key>
	<string>com.trifectadb.maxpane</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- What makes macOS offer this in Settings › Desktop & Dock › Default web
	     browser. Declaring the schemes is what makes it *eligible*; the user
	     still chooses. Both schemes are required — an app that claims only
	     https does not appear in the list at all. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<!-- Web lanes load ordinary sites; WebKit's own TLS handling applies. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- The strip is the interface. Auto-hide the menu bar in fullscreen. -->
	<key>LSUIPresentationMode</key>
	<integer>4</integer>
</dict>
</plist>
