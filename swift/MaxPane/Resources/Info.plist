<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Max Pane</string>
	<key>CFBundleDisplayName</key>
	<string>Max Pane</string>
	<key>CFBundleExecutable</key>
	<string>MaxPane</string>
	<key>CFBundleIdentifier</key>
	<string>com.trifectadb.maxpane</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- What makes macOS offer this in Settings › Desktop & Dock › Default web
	     browser. Declaring the schemes is what makes it *eligible*; the user
	     still chooses. Both schemes are required — an app that claims only
	     https does not appear in the list at all. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<!-- Without these two strings, a page calling `getUserMedia` does not get a
	     permission prompt: TCC kills the process. There is no error, no log
	     line and no crash report the user would connect to the video call they
	     were joining — the window simply disappears. Granting the permission in
	     the app is necessary and not sufficient; macOS asks the *app* first,
	     and it will only ask on behalf of a bundle that has said why.

	     The wording names the site rather than the app, because the app is not
	     the thing that wants the camera and the sheet in the pane has already
	     said which site is. -->
	<key>NSCameraUsageDescription</key>
	<string>A web page in a lane is asking to use the camera. Max Pane asks you about each site before it does.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A web page in a lane is asking to use the microphone. Max Pane asks you about each site before it does.</string>
	<!-- Web lanes load ordinary sites; WebKit's own TLS handling applies.

	     `NSAllowsArbitraryLoadsInWebContent` is the narrow key and the reason
	     both are here: it lifts ATS for WKWebView *only*, and everything the app
	     itself connects to stays under `NSAllowsArbitraryLoads=false`.

	     Without it, plain http to anything off the loopback did not load and
	     said nothing — `http://example.com/`, which curl fetches with 200 from
	     this machine, simply did not happen. This is a developer's browser:
	     old vendor docs, an internal service reached through a tunnel and a LAN
	     box on port 8731 are all http and all real, and a browser that refuses
	     them without a word is worse than one that loads them with a warning.

	     The warning is what carries the weight, and it already exists: the amber
	     ⚠ before the address on any http page that is not the loopback, live
	     while you are still typing the address. See `BrowserAddress.security`. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- The strip is the interface. Auto-hide the menu bar in fullscreen. -->
	<key>LSUIPresentationMode</key>
	<integer>4</integer>
</dict>
</plist>
